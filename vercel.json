{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next",
      "config": { "installCommand": "pnpm install", "buildCommand": "pnpm --filter @codeautopsy/web build" }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "apps/web/$1" }]
}
