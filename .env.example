# ---- web (Next.js) ----
# Postgres connection (Supabase: Project Settings → Database → Connection string)
# Leave unset to use the zero-config file store at apps/web/.data/
DATABASE_URL=
# Supabase (optional, reserved for auth/storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- execution node ----
# URL the web API uses to reach the execution node
EXECUTION_NODE_URL=http://127.0.0.1:8787
# Shared secret between web and execution node (recommended in production)
AUTOPSY_NODE_SECRET=
# local (dev) or docker (isolated per-submission containers)
AUTOPSY_SANDBOX=local
# where the node POSTs finished results
AUTOPSY_CALLBACK_URL=http://127.0.0.1:3000/api/internal/execution-callback
# C++ compiler override
AUTOPSY_CXX=g++

# ---- optional free-tier LLM narrative ----
# Google AI Studio (https://aistudio.google.com/apikey) — free tier
GEMINI_API_KEY=
# OpenRouter free models as backup (https://openrouter.ai)
OPENROUTER_API_KEY=
